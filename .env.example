# Copy this file to .env and edit. Every setting is optional; the values shown are the defaults.

# ---------- Mode ----------
# paper = fake money (default). Live trading needs ALL THREE:
#   MODE=live, LIVE_CONFIRM=YES_REAL_MONEY, and starting with `npm run live`.
MODE=paper
LIVE_CONFIRM=

# ---------- Connections ----------
# Public RPC is fine for paper trading. For live trading get a free key at helius.dev and use
#   RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
RPC_URL=https://api.mainnet-beta.solana.com
PUMPPORTAL_WS=wss://pumpportal.fun/api/data
PUMPPORTAL_API_KEY=
DASHBOARD_PORT=3000
WALLET_PATH=wallet/bot-wallet.json
# How often coin prices are refreshed (ms) and how many new coins to watch at once
POLL_MS=1000
MAX_WATCHLIST=80

# ---------- Bankroll & sizing ----------
# Paper account starts with this many USD worth of SOL (PAPER_START_SOL if the SOL price is unavailable)
PAPER_START_USD=25
PAPER_START_SOL=0.15
TRADE_SIZE_SOL=0.02
MAX_OPEN_POSITIONS=2
# Always keep at least this much SOL for fees
MIN_SOL_RESERVE=0.02

# ---------- Costs ----------
# Priority fee per transaction. Lower = cheaper but slower to land.
PRIORITY_FEE_SOL=0.0002
BASE_FEE_SOL=0.000005
# pump.fun bonding-curve fee and PumpPortal's fee, % per trade
PUMP_FEE_PCT=1.25
PUMPPORTAL_FEE_PCT=0.5
# Rent for the token account, refunded when the account is closed after selling
ATA_RENT_SOL=0.00203928
BUY_SLIPPAGE_PCT=20
SELL_SLIPPAGE_PCT=40

# ---------- Paper simulator ----------
# Delay between the decision and the fill (real bots are not instant)
SIM_LATENCY_MS=1500
# Fraction of transactions that fail (0.05 = 5%); failed ones still pay the network fee
SIM_FAIL_RATE=0.05

# ---------- Momentum entry ----------
# Watch each new coin for this many seconds after launch
WATCH_WINDOW_SEC=45
# Skip coins where the creator bought more than this % of the supply at launch
MAX_DEV_BUY_PCT=10
# Skip pump.fun "Mayhem mode" coins (different curve)
SKIP_MAYHEM=true
# Buy only if market cap is up at least this % since launch...
MIN_MCAP_GAIN_PCT=25
# ...at least this much real SOL has gone into the curve...
MIN_REAL_SOL=3
# ...the curve is not too close to graduating...
MAX_CURVE_PROGRESS_PCT=50
# ...and the price is higher than it was this many seconds ago
RISING_LOOKBACK_SEC=5

# ---------- Exits ----------
TAKE_PROFIT_PCT=40
STOP_LOSS_PCT=20
# Once up TRAIL_ACTIVATE_PCT, sell if the price falls TRAIL_DROP_PCT from its peak
TRAIL_ACTIVATE_PCT=20
TRAIL_DROP_PCT=15
MAX_HOLD_SEC=180

# ---------- Risk guard ----------
# Stop opening trades for the rest of the day after losing this % of the day's starting equity
DAILY_LOSS_LIMIT_PCT=30
# Pause COOLDOWN_MIN minutes after this many losses in a row
MAX_CONSEC_LOSSES=3
COOLDOWN_MIN=5
MAX_TRADES_PER_HOUR=20

# ---------- Live safety ----------
# Comma-separated extra program IDs the live safety check may allow. Leave empty unless
# `npm run live:check` reports a program you have verified is legitimate.
EXTRA_ALLOWED_PROGRAMS=
