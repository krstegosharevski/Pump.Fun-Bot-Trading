# Copy this file to .env and edit. Every setting is optional; the values shown are the defaults.

# ---------- Mode ----------
# paper = fake money (default). Live trading needs ALL THREE:
#   MODE=live, LIVE_CONFIRM=YES_REAL_MONEY, and starting with `npm run live`.
MODE=paper
LIVE_CONFIRM=

# ---------- Connections ----------
# Public RPC is fine for paper trading. For live trading get a free key at helius.dev and use
#   RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
RPC_URL=https://api.mainnet-beta.solana.com
PUMPPORTAL_WS=wss://pumpportal.fun/api/data
PUMPPORTAL_API_KEY=
DASHBOARD_PORT=3000
WALLET_PATH=wallet/bot-wallet.json
# How often coin prices are refreshed (ms) and how many new coins to watch at once
POLL_MS=1000
MAX_WATCHLIST=80

# ---------- Recording (data for `npm run backtest`) ----------
# Save every promising coin's price path to data/ticks/ (roughly tens of MB per day)
RECORD_TICKS=true
# Keep recording a promising coin this many seconds after its watch window
SHADOW_SEC=300
MAX_SHADOW=60

# ---------- Bankroll & sizing ----------
# Paper account starts with this many USD worth of SOL (PAPER_START_SOL if the SOL price is unavailable)
PAPER_START_USD=25
PAPER_START_SOL=0.15
TRADE_SIZE_SOL=0.02
# If above 0, each trade is this % of your current balance instead of TRADE_SIZE_SOL
TRADE_SIZE_PCT=0
# Never put more than this into one trade
MAX_TRADE_SOL=0.5
MAX_OPEN_POSITIONS=2
# Always keep at least this much SOL for fees
MIN_SOL_RESERVE=0.02

# ---------- Costs ----------
# Priority fee per transaction. Lower = cheaper but slower to land.
PRIORITY_FEE_SOL=0.0002
BASE_FEE_SOL=0.000005
# pump.fun bonding-curve fee and PumpPortal's fee, % per trade
PUMP_FEE_PCT=1.25
PUMPPORTAL_FEE_PCT=0.5
# Rent for the token account, refunded when the account is closed after selling
ATA_RENT_SOL=0.00203928
BUY_SLIPPAGE_PCT=20
SELL_SLIPPAGE_PCT=40

# ---------- Paper simulator ----------
# Delay between the decision and the fill (real bots are not instant)
SIM_LATENCY_MS=1500
# Fraction of transactions that fail (0.05 = 5%); failed ones still pay the network fee
SIM_FAIL_RATE=0.05

# ---------- Momentum entry ----------
# Watch each new coin for this many seconds after launch
WATCH_WINDOW_SEC=45
# Skip coins where the creator bought more than this % of the supply at launch
MAX_DEV_BUY_PCT=10
# Skip pump.fun "Mayhem mode" coins (different curve)
SKIP_MAYHEM=true
# Buy only if market cap is up at least this % since launch...
MIN_MCAP_GAIN_PCT=25
# ...at least this much real SOL has gone into the curve...
MIN_REAL_SOL=3
# ...the curve is not too close to graduating...
MAX_CURVE_PROGRESS_PCT=50
# ...and the price is higher than it was this many seconds ago
RISING_LOOKBACK_SEC=5

# ---------- Exits ----------
TAKE_PROFIT_PCT=40
STOP_LOSS_PCT=20
# Once up TRAIL_ACTIVATE_PCT, sell if the price falls TRAIL_DROP_PCT from its peak
TRAIL_ACTIVATE_PCT=25
TRAIL_DROP_PCT=10
MAX_HOLD_SEC=180

# ---------- Tabak 1-1 (launch sniper) ----------
# Logic from github.com/chainstacklabs/pumpfun-bonkfun-bot. Primal 1-1 uses the settings above.
# Buy the moment a coin is announced ("extreme fast mode"), if it is at most this many seconds old
TABAK_EXTREME_FAST=true
TABAK_MAX_TOKEN_AGE_SEC=2
# With extreme fast off: wait this long after launch, then buy
TABAK_WAIT_AFTER_CREATION_SEC=15
# Pause after each coin before taking the next one (one coin at a time)
TABAK_WAIT_BEFORE_NEW_TOKEN_SEC=15
# Optional filters: name/symbol contains this text, or created by this wallet address
TABAK_MATCH_STRING=
TABAK_CREATOR=
# time_based = sell TABAK_WAIT_AFTER_BUY_SEC after buying, whatever the price
# tp_sl      = sell at take profit, stop loss, or after TABAK_MAX_HOLD_SEC
TABAK_EXIT_STRATEGY=time_based
TABAK_WAIT_AFTER_BUY_SEC=15
TABAK_TAKE_PROFIT_PCT=40
TABAK_STOP_LOSS_PCT=40
TABAK_MAX_HOLD_SEC=15
TABAK_MAX_TRADES_PER_HOUR=120

# ---------- Blazebit 1-1 (hot meme coins) ----------
# Trades graduated pump.fun coins from GeckoTerminal's 1h trending list (free, no key).
BLAZE_REFRESH_SEC=60
BLAZE_POLL_MS=1500
# What counts as a hot meme coin
BLAZE_MIN_MCAP_USD=100000
BLAZE_MAX_MCAP_USD=20000000
BLAZE_MIN_LIQUIDITY_USD=30000
BLAZE_MIN_VOLUME_1H_USD=50000
BLAZE_MIN_BUYERS_1H=100
BLAZE_MIN_CHANGE_1H_PCT=20
# Buy only while still climbing: 5-minute change in this range, and price up over the lookback
BLAZE_MIN_CHANGE_5M_PCT=3
BLAZE_MAX_CHANGE_5M_PCT=40
BLAZE_RISING_LOOKBACK_SEC=30
# Don't buy the same coin again for this many minutes
BLAZE_COIN_COOLDOWN_MIN=60
BLAZE_TAKE_PROFIT_PCT=30
BLAZE_STOP_LOSS_PCT=12
BLAZE_TRAIL_ACTIVATE_PCT=20
BLAZE_TRAIL_DROP_PCT=10
BLAZE_MAX_HOLD_MIN=30
BLAZE_MAX_OPEN_POSITIONS=3
BLAZE_MAX_TRADES_PER_HOUR=10
# PumpSwap fee per trade, measured on-chain: 0.20% LP + 0.05% protocol + 0.75% creator
BLAZE_POOL_FEE_PCT=1.0

# ---------- Risk guard ----------
# Stop opening trades for the rest of the day after losing this % of the day's starting equity
DAILY_LOSS_LIMIT_PCT=30
# Pause COOLDOWN_MIN minutes after this many losses in a row
MAX_CONSEC_LOSSES=3
COOLDOWN_MIN=5
MAX_TRADES_PER_HOUR=20

# ---------- Live safety ----------
# Comma-separated extra program IDs the live safety check may allow. Leave empty unless
# `npm run live:check` reports a program you have verified is legitimate.
EXTRA_ALLOWED_PROGRAMS=
